# Postgres (en Railway: agregar un servicio Postgres y referenciar ${{Postgres.DATABASE_URL}}).
# Sin esta variable, en local se usa PGlite en ./.datos
DATABASE_URL=

# Mails (Resend). Sin la key, los mails se imprimen en la consola.
RESEND_API_KEY=
MAIL_FROM=Casapri <no-responder@tudominio.com>

# Mails de los socios: al registrarse con estos mails quedan como administradores. Separados por coma.
ADMIN_EMAILS=

# URL pública (para los enlaces de los mails). Opcional: si no está, se toma del pedido.
APP_URL=

NODE_ENV=production
